datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

enum DocumentType {
  KTP
  NPWP
  BPJS_KES
  BPJS_TK
  IJAZAH
  SERTIFIKAT
  KONTRAK
  LAINNYA
}

enum ScanStatus {
  PENDING
  CLEAN
  QUARANTINED
}

enum ContractType {
  PERMANENT
  CONTRACT
  PROBATION
  INTERNSHIP
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum AssignmentType {
  INITIAL
  PROMOTION
  TRANSFER
  DEMOTION
  REORGANIZATION
}

enum MovementType {
  HIRE
  PROMOTION
  TRANSFER
  DEMOTION
  REORGANIZATION
  TERMINATION
  REACTIVATION
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  employeeId   String?  @unique @map("employee_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee            Employee?                    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]                   @relation("UserAuditLogs")
  uploadedDocuments   EmployeeDocument[]           @relation("UserUploadedDocuments")
  positionAssignments EmployeePositionAssignment[] @relation("UserPositionAssignments")
  performedMovements  EmployeeMovementHistory[]    @relation("UserPerformedMovements")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Department {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  employees Employee[]

  positionAssignments     EmployeePositionAssignment[]
  movementFromDepartments EmployeeMovementHistory[]    @relation("MovementFromDepartment")
  movementToDepartments   EmployeeMovementHistory[]    @relation("MovementToDepartment")

  @@map("departments")
}

model Employee {
  id           String         @id @default(uuid())
  departmentId String         @map("department_id")
  nip          String         @unique
  fullName     String         @map("full_name")
  email        String         @unique
  phone        String?
  jobTitle     String         @map("job_title")
  hireDate     DateTime       @map("hire_date") @db.Date
  baseSalary   Decimal        @map("base_salary") @db.Decimal(15, 2)
  status       EmployeeStatus @default(ACTIVE)
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  department                Department                   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user                      User?
  attendances               Attendance[]
  leaveRequests             LeaveRequest[]               @relation("EmployeeLeaveRequests")
  approvedLeaves            LeaveRequest[]               @relation("ApprovedLeaveRequests")
  payrolls                  Payroll[]
  emergencyContacts         EmployeeEmergencyContact[]
  documents                 EmployeeDocument[]
  contracts                 EmploymentContract[]
  positionAssignments       EmployeePositionAssignment[]
  subordinateReportingLines EmployeeReportingLine[]      @relation("SubordinateReportingLines")
  managerReportingLines     EmployeeReportingLine[]      @relation("ManagerReportingLines")
  movementHistories         EmployeeMovementHistory[]

  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

model Attendance {
  id             String           @id @default(uuid())
  employeeId     String           @map("employee_id")
  attendanceDate DateTime         @map("attendance_date") @db.Date
  checkIn        DateTime?        @map("check_in")
  checkOut       DateTime?        @map("check_out")
  status         AttendanceStatus
  notes          String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, attendanceDate])
  @@index([status])
  @@index([employeeId])
  @@index([attendanceDate])
  @@map("attendances")
}

model LeaveRequest {
  id              String             @id @default(uuid())
  employeeId      String             @map("employee_id")
  approvedBy      String?            @map("approved_by")
  leaveType       LeaveType          @map("leave_type")
  startDate       DateTime           @map("start_date") @db.Date
  endDate         DateTime           @map("end_date") @db.Date
  status          LeaveRequestStatus @default(PENDING)
  reason          String
  rejectionReason String?            @map("rejection_reason")
  approvedAt      DateTime?          @map("approved_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  employee Employee  @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Restrict)
  approver Employee? @relation("ApprovedLeaveRequests", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([employeeId])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model Payroll {
  id          String        @id @default(uuid())
  employeeId  String        @map("employee_id")
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  basicSalary Decimal       @map("basic_salary") @db.Decimal(15, 2)
  allowances  Decimal       @map("allowances") @db.Decimal(15, 2)
  deductions  Decimal       @map("deductions") @db.Decimal(15, 2)
  netSalary   Decimal       @map("net_salary") @db.Decimal(15, 2)
  paymentDate DateTime?     @map("payment_date") @db.Date
  status      PayrollStatus @default(DRAFT)
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, periodStart, periodEnd])
  @@index([status])
  @@index([employeeId])
  @@index([periodStart, periodEnd])
  @@map("payrolls")
}

model WorkSchedule {
  id                   String   @id @default(uuid())
  startTime            String   @map("start_time") // Format: "HH:mm" (e.g. "09:00" in WIB / Asia/Jakarta)
  lateToleranceMinutes Int      @default(15) @map("late_tolerance_minutes")
  standardWorkMinutes  Int      @default(480) @map("standard_work_minutes")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("work_schedules")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  actorEmail    String?  @map("actor_email")
  actorRole     String?  @map("actor_role")
  action        String
  entity        String
  entityId      String   @map("entity_id")
  before        Json?
  after         Json?
  source        String   @default("USER")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmployeeEmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

model EmployeeDocument {
  id            String       @id @default(uuid())
  employeeId    String       @map("employee_id")
  documentType  DocumentType @map("document_type")
  title         String
  fileName      String       @map("file_name")
  storagePath   String       @map("storage_path")
  mimeType      String       @map("mime_type")
  fileSizeBytes Int          @map("file_size_bytes")
  scanStatus    ScanStatus   @default(PENDING) @map("scan_status")
  expiryDate    DateTime?    @map("expiry_date") @db.Date
  uploadedById  String       @map("uploaded_by_id")
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  uploadedBy User                 @relation("UserUploadedDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)
  contracts  EmploymentContract[]

  @@index([employeeId])
  @@index([documentType])
  @@index([expiryDate])
  @@map("employee_documents")
}

model EmploymentContract {
  id                  String         @id @default(uuid())
  employeeId          String         @map("employee_id")
  contractType        ContractType   @map("contract_type")
  contractNumber      String         @unique @map("contract_number")
  startDate           DateTime       @map("start_date") @db.Date
  endDate             DateTime?      @map("end_date") @db.Date
  status              ContractStatus @default(ACTIVE)
  renewalReminderDate DateTime?      @map("renewal_reminder_date") @db.Date
  notes               String?
  documentId          String?        @map("document_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  document EmployeeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([endDate])
  @@index([renewalReminderDate])
  @@map("employment_contracts")
}

model Position {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  level       Int
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assignments  EmployeePositionAssignment[]
  movementFrom EmployeeMovementHistory[]    @relation("MovementFromPosition")
  movementTo   EmployeeMovementHistory[]    @relation("MovementToPosition")

  @@index([isActive])
  @@index([level])
  @@map("positions")
}

model EmployeePositionAssignment {
  id             String         @id @default(uuid())
  employeeId     String         @map("employee_id")
  positionId     String         @map("position_id")
  departmentId   String         @map("department_id")
  effectiveFrom  DateTime       @map("effective_from") @db.Date
  effectiveTo    DateTime?      @map("effective_to") @db.Date
  assignmentType AssignmentType @map("assignment_type")
  notes          String?
  assignedById   String         @map("assigned_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  position   Position   @relation(fields: [positionId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedBy User       @relation("UserPositionAssignments", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
  @@index([positionId])
  @@index([departmentId])
  @@map("employee_position_assignments")
}

model EmployeeReportingLine {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  managerId     String    @map("manager_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isPrimary     Boolean   @default(true) @map("is_primary")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  subordinate Employee @relation("SubordinateReportingLines", fields: [employeeId], references: [id], onDelete: Restrict)
  manager     Employee @relation("ManagerReportingLines", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
  @@index([managerId])
  @@map("employee_reporting_lines")
}

model EmployeeMovementHistory {
  id               String       @id @default(uuid())
  employeeId       String       @map("employee_id")
  movementType     MovementType @map("movement_type")
  fromPositionId   String?      @map("from_position_id")
  toPositionId     String?      @map("to_position_id")
  fromDepartmentId String?      @map("from_department_id")
  toDepartmentId   String?      @map("to_department_id")
  effectiveDate    DateTime     @map("effective_date") @db.Date
  reason           String?
  performedById    String       @map("performed_by_id")
  createdAt        DateTime     @default(now()) @map("created_at")

  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  fromPosition   Position?   @relation("MovementFromPosition", fields: [fromPositionId], references: [id], onDelete: SetNull)
  toPosition     Position?   @relation("MovementToPosition", fields: [toPositionId], references: [id], onDelete: SetNull)
  fromDepartment Department? @relation("MovementFromDepartment", fields: [fromDepartmentId], references: [id], onDelete: SetNull)
  toDepartment   Department? @relation("MovementToDepartment", fields: [toDepartmentId], references: [id], onDelete: SetNull)
  performedBy    User        @relation("UserPerformedMovements", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveDate])
  @@index([movementType])
  @@map("employee_movement_histories")
}
