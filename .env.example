# Application Configuration
PORT=3000

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/erp_hris_db?schema=public"

# JWT Authentication Configuration
# Use strong, random strings in production (e.g. generated via `openssl rand -base64 32`)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-min-32-chars"
JWT_ACCESS_EXPIRATION="15m"

JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars"
JWT_REFRESH_EXPIRATION="7d"
